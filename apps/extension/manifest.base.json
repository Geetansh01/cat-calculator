{
  "manifest_version": 3,
  "name": "CAT On-Screen Calculator - Floating Overlay",
  "short_name": "CAT Calculator",
  "version": "1.0.0",
  "description": "A draggable CAT exam calculator that floats on top of any website while you practise. Free, no ads, collects no data.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open CAT calculator",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" }
    }
  }
}
